# Copy to .env, or run "npm run init" to generate real keys. Never commit the real file.
FILE_ENC_KEY=<64 hex chars: openssl rand -hex 32>
AUDIT_HMAC_KEY=<a DIFFERENT 64 hex chars>
# Needed only if people may self-register as Administrator (12+ chars). Leave empty to disable.
ADMIN_REGISTRATION_CODE=
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=0   # set 1 behind HTTPS
TRUST_PROXY=0     # set 1 only behind a proxy you control
