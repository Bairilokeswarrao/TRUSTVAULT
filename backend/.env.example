# TrustVault Environment Configuration Template
# For local dev: run "npm run init" to generate a backend/.env file with real keys.
# For Render / production: set these in your cloud provider's Environment variables.
# NEVER commit the real .env file with secrets to Git.

# Cryptographic Keys (Required - exactly 64 hex characters / 32 bytes each)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or run: npm run init -- --generate
# MUST be two DIFFERENT keys. Do NOT use placeholder text or reuse keys.
FILE_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUDIT_HMAC_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Security and Networking
# On Render: HOST=0.0.0.0 (Render handles PORT automatically)
# Local: HOST=127.0.0.1
PORT=3000
HOST=127.0.0.1

# Production Settings on Render (HTTPS + Reverse Proxy)
# Set COOKIE_SECURE=1 in production (adds Secure cookies + HSTS)
COOKIE_SECURE=0
# Set TRUST_PROXY=1 when hosted behind a reverse proxy like Render or Cloudflare
TRUST_PROXY=0

# Administrator registration code (12+ chars). Leave empty to disable self-registration.
ADMIN_REGISTRATION_CODE=

# Limits & Retention
MAX_UPLOAD_MB=10
RETENTION_DAYS=30
